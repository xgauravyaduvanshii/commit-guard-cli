{"author": "Gaurav Kumar Yadav", "bin": {"commit-guard": "./dist/cli.js"}, "bugs": {"url": "https://github.com/xgauravyaduvanshii/commit-guard-cli/issues"}, "description": "Zero-dependency pre-commit guard that blocks staged secrets, .env / private-key files and oversized files \u2014 without ever printing a secret value.", "devDependencies": {"@types/node": "^22.10.2", "typescript": "^5.7.2", "vitest": "^2.1.8"}, "engines": {"node": ">=18"}, "files": ["dist", "README.md", "LICENSE"], "homepage": "https://github.com/xgauravyaduvanshii/commit-guard-cli#readme", "keywords": ["git", "pre-commit", "secrets", "security", "cli", "ci", "gitleaks-alternative"], "license": "MIT", "main": "./dist/cli.js", "name": "commit-guard-cli", "repository": {"type": "git", "url": "https://github.com/xgauravyaduvanshii/commit-guard-cli.git"}, "scripts": {"build": "tsc -p tsconfig.build.json", "lint": "tsc --noEmit", "test": "vitest run"}, "type": "module", "version": "0.2.0"}